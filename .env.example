# ==================================
# TAXI APP CONFIGURATION
# ==================================
# Copy this file to .env and configure your values
# NEVER commit sensitive data to version control!

# ==================================
# SERVER CONFIGURATION
# ==================================
# Base URL of your taxi backend server (required)
REACT_APP_SERVER_BASE_URL=https://your-taxi-backend.com

# Direct API URL (optional - will use SERVER_BASE_URL/api/v1 if not set)
REACT_APP_API_URL=

# ==================================
# MAP SERVICES (Choose one)
# ==================================
# OpenRouteService Token (for routing)
REACT_APP_ORS_TOKEN=your_openrouteservice_token_here

# HERE Maps API Key (alternative to ORS)
REACT_APP_HERE_API_KEY=your_here_api_key_here

# ==================================
# PAYMENT PROCESSING
# ==================================
# YooKassa Payment Gateway
REACT_APP_YOOKASSA_SHOP_ID=your_yookassa_shop_id
REACT_APP_YOOKASSA_SECRET_KEY=your_yookassa_secret_key

# ==================================
# WHATSAPP INTEGRATION (Optional)
# ==================================
# WhatsApp Bot URL for notifications
REACT_APP_WHATSAPP_BOT_URL=https://your-whatsapp-bot.com

# WhatsApp Bot Authentication Key
REACT_APP_WHATSAPP_BOT_KEY=your_whatsapp_bot_key

# ==================================
# APPLICATION SETTINGS
# ==================================
# Enable development mode features (set to 'true' for development)
REACT_APP_DEBUG_MODE=false

# Default language (1=Russian, 2=English)
REACT_APP_DEFAULT_LANGUAGE=2

# Default currency (USD, EUR, RUB)
REACT_APP_DEFAULT_CURRENCY=USD

# Enable real-time features (set to 'true' to enable WebSocket connections)
REACT_APP_ENABLE_REALTIME=true

# WebSocket URL for real-time updates (optional - will auto-detect if not set)
REACT_APP_WS_URL=

# Google Analytics ID (optional)
REACT_APP_GA_TRACKING_ID=

# Sentry DSN for error tracking (optional)
REACT_APP_SENTRY_DSN=